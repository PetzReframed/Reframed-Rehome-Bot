# Copy to .env and fill in. Restart the container after editing: docker compose up -d

# The bot token of your Discord application (Developer Portal > your application > Bot > Reset Token).
# Keep it secret: anyone who has it can post as the bot.
DISCORD_BOT_TOKEN=

# The numeric ID of the channel to post in (Discord > Settings > Advanced > Developer Mode, then right-click the
# channel > Copy Channel ID). The bot needs View Channel, Send Messages and Attach Files there; editing its own
# messages needs no further permission.
DISCORD_CHANNEL_ID=

# The game server's rehoming folder on this host: the "rehoming" folder inside the game's data folder
# (PETZ_DATA_DIR in the game's .env), the one that holds "available" and "claimed". Used by compose.yaml for the
# read-only mount.
REHOMING_HOST_DIR=/opt/docker/reframed/data/rehoming

# How often the folder is looked at, in seconds (1-3600). A pet is called adopted only when a look saw it out on a
# visit before it left, so keep this well under the time a visit and its adoption take.
POLL_SECONDS=5

# false: pets already waiting when the bot first starts are taken as known and never posted.
# true: they are all posted at the first start, the one offered first first.
POST_EXISTING=false

# Upload the pet's saved picture with its message. The picture is the one the game shows beside the list of waiting
# pets; the game server does not look at pictures. false posts the text alone.
ATTACH_PICTURE=true

# The largest pet file read, in bytes (65536-1048576), and the most entries expected in each of the two folders
# (1-10000). The defaults are the largest values the game server accepts for PETZ_REHOMING_MAX_PET_BYTES and
# PETZ_REHOMING_MAX_PETS. A larger file is not posted; a fuller folder is not read at all.
MAX_PET_BYTES=1048576
MAX_PETS=10000

# The image to run. Override for a pinned version tag.
BOT_IMAGE=ghcr.io/petzreframed/reframed-rehome-bot:main
